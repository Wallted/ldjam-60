[sub_resource type="Resource" id="Resource_b1cj3"]
script = ExtResource("4_b1cj3")
message = "Ha-ha-ha! Are you kidding me? This widdle guy? What's you name boy?"

[sub_resource type="Resource" id="Resource_q4fnq"]
script = ExtResource("4_b1cj3")
message = "David huh? Like the King. Well you sure are brave."

[sub_resource type="Resource" id="Resource_aanv1"]
script = ExtResource("4_b1cj3")
message = "Ohhh that's cute... Hey guys! He's got a little slingshot there."

[sub_resource type="Resource" id="Resource_1uwfe"]
script = ExtResource("4_b1cj3")
message = "Wait this is going to be fun."

[sub_resource type="Resource" id="Resource_de0nt"]
script = ExtResource("4_b1cj3")
message = "Ok I'll give you one... maybe two... ok I'll let you have 5 shots at me..."

[sub_resource type="Resource" id="Resource_a0c8x"]
script = ExtResource("4_b1cj3")
message = "And after that I promise to kill you quickly."

[sub_resource type="Resource" id="Resource_66v02"]
script = ExtResource("4_b1cj3")
message = "Hah! That tickled my forehead! Wait where am I?"

