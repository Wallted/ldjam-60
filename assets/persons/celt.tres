[sub_resource type="Resource" id="Resource_kkk1n"]
script = ExtResource("4_kkk1n")
message = "Druid told me that this place will link us to cosmic beings..."

[sub_resource type="Resource" id="Resource_r57vc"]
script = ExtResource("4_kkk1n")
message = "But from what he said it's just a stone circle!"

[sub_resource type="Resource" id="Resource_rbwjm"]
script = ExtResource("4_kkk1n")
message = "But I bet our descendants will pay for tickets to see it. Mark my words!"

[sub_resource type="Resource" id="Resource_q30jn"]
script = ExtResource("4_kkk1n")
message = "AND WHY DOESN'T IT HAVE A BUILD MANUAL!"

[sub_resource type="Resource" id="Resource_x510s"]
script = ExtResource("4_kkk1n")
message = "Like... Where this stone is supposed to go?"

[sub_resource type="Resource" id="Resource_uftbc"]
script = ExtResource("4_kkk1n")
message = "Ohh that's why..."

