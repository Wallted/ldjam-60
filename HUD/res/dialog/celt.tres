script = ExtResource("1_5qo7x")
entry_messages = ["Druid told me that this place will link us to cosmic beings...", "But from what he said it's just a stone circle!", "But I bet our descendants will pay for tickets to see it. Mark my words!", "AND WHY DOESN'T IT HAVE A BUILD MANUAL!", "Like... Where this stone is supposed to go?", "Ohh that's why..."]
