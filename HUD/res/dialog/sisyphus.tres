entry_messages = ["Argh! Cursed stone!...", "I've been dealing with it for centuries!...", "But you know what?...", "I think this is the worst infrastructure I've seen in my life! Come on...", "Alright my guy... One more time up the hill and we'll go for a beer...", "Wait... I'm inside? Neat! I can work like a hamster now!"]
